{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci",
  "buildCommand": "NEON_LESSON_DUPLICATE_MIGRATION_APPROVED=I_UNDERSTAND_THIS_ADDS_ATOMIC_DUPLICATION_TO_NEON_STAGING node scripts/neon/apply-lesson-duplicate-migration.mjs && npm run build",
  "crons": [
    {
      "path": "/api/cron/organization-billing",
      "schedule": "17 3 * * *"
    },
    {
      "path": "/api/cron/service-changes",
      "schedule": "37 3 * * *"
    }
  ]
}
