{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci",
  "buildCommand": "npm run neon:verify-lesson-move-write && npm run build",
  "crons": [
    {
      "path": "/api/cron/organization-billing",
      "schedule": "17 3 * * *"
