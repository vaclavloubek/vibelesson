{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci && npm install pg@8.23.0 --no-save",
  "buildCommand": "node scripts/neon/security-audit.mjs && npm run build",
  "crons": [
    {
      "path": "/api/cron/organization-billing",
      "schedule": "17 3 * * *"
    },
    {
      "path": "/api/cron/service-changes",
      "schedule": "37 3 * * *"
    }
  ]
}
