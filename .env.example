# Syllonaut AI configuration
# For local development set an AI Gateway API key.
AI_GATEWAY_API_KEY=

# Optional. Defaults to openai/gpt-5.6-sol when omitted.
AI_MODEL=openai/gpt-5.6-sol

# Database: Neon (production since 2026-09-23). Local development and Vercel
# Preview use the Neon branch `preview` (schema and plan catalog only, no
# production data), never the production branch. Take the connection string,
# Auth URL and Data API URL of the `preview` branch from the Neon Console; the
# Vercel Preview values are sensitive and cannot be pulled.
DATABASE_BACKEND=neon
NEXT_PUBLIC_DATABASE_BACKEND=neon
NEON_CUTOVER_APPROVED=true
NEON_DATABASE_URL=
NEON_DATABASE_URL_UNPOOLED=
NEON_DATA_API_URL=
# Migration-era canaries: ignored when DATABASE_BACKEND=neon (every Neon path is on).
NEON_SHARED_LESSON_READS=false
NEON_LESSON_FOLDER_READS=false
NEON_LESSON_FOLDER_WRITES=false
NEON_LESSON_MOVE_WRITES=false
NEON_LESSON_CONTENT_WRITES=false
NEON_LESSON_DELETE_WRITES=false
NEON_LESSON_DUPLICATE_WRITES=false
NEON_LESSON_SHARE_WRITES=false
NEON_SHARED_LESSON_IMPORT_WRITES=false
NEON_LESSON_LIST_READS=false
NEON_SESSION_HISTORY_READS=false
NEON_LESSON_DETAIL_READS=false
NEON_LESSON_WORKSHEET_READS=false
NEON_LESSON_REUSE_READS=false
NEON_SESSION_ACCESS_READS=false
NEON_LIVE_SESSION_DATA=false
NEON_GRADING_OUTBOX_WORKER=false
NEXT_PUBLIC_NEON_DATA_API_URL=
NEON_AUTH_BASE_URL=
NEXT_PUBLIC_NEON_AUTH_URL=
# Any random value of at least 32 characters, e.g. `openssl rand -base64 48`.
NEON_AUTH_COOKIE_SECRET=

# Supabase: read-only backup since 2026-09-23. Used only with
# DATABASE_BACKEND=supabase; leave empty for normal development.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Neon app Auth forms validate Turnstile tokens on the server. Production uses
# its own widget. Preview and local development use Cloudflare's always-pass
# test keys below; the server accepts the test secret only outside production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Migration tooling only; do not configure this in the Vercel application.
SUPABASE_DB_URL=

# Stripe webhook signing secrets. Test and live endpoints have different secrets.
# Keep these server-only. Multiple rotating secrets can be comma-separated temporarily.
STRIPE_WEBHOOK_SECRET_TEST=
STRIPE_WEBHOOK_SECRET_LIVE=

# Server-only Stripe restricted keys used for Checkout/Customer/Portal operations.
# Keep sandbox and live credentials strictly separate; never expose them through NEXT_PUBLIC_*.
STRIPE_SECRET_KEY_TEST=
STRIPE_SECRET_KEY_LIVE=

# Public LIVE individual billing is launched by default. Set explicitly to false for an emergency rollback.
STRIPE_LIVE_BILLING_PUBLIC_ENABLED=true

# Server-only Resend credential for Syllonaut transactional subscription lifecycle emails.
# Payment receipts, refunds and failed-payment emails remain Stripe-owned.
RESEND_API_KEY=
BILLING_EMAIL_FROM="Syllonaut <billing@syllonaut.com>"
BILLING_EMAIL_REPLY_TO=vaclav@syllonaut.com

# Optional analytics. GA4 is loaded only after explicit cookie consent.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional. Use only with a dedicated non-production GA4 stream for DebugView QA.
NEXT_PUBLIC_GA_DEBUG_MODE=false

# Server-only secret used by Vercel Cron to protect billing lifecycle maintenance.
CRON_SECRET=

# Team / School / Campus self-service is public. Emergency kill switch:
# set to true to close school billing for everyone except admins.
STRIPE_LIVE_SCHOOL_BILLING_EMERGENCY_DISABLED=false
