{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "syllonaut-live",
  "main": "src/index.mjs",
  "compatibility_date": "2026-09-18",
  "durable_objects": { "bindings": [{ "name": "LIVE_SESSIONS", "class_name": "LiveSession" }] },
  "exports": { "LiveSession": { "type": "durable-object", "storage": "sqlite" } },
  "vars": { "ALLOWED_ORIGINS": "https://www.syllonaut.com,https://syllonaut.com" }
}
